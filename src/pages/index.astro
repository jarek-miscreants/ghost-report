            <tr><td class="gs-vb-leaderboard__rank">13</td><td><div class="gs-vb-leaderboard__model">Gemini 3.1 Pro</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--google">Google</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">2.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:11.1%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.093</td><td class="gs-vb-leaderboard__meta">5/200</td><td class="gs-vb-leaderboard__meta">44.4s</td><td class="gs-vb-leaderboard__meta">$9.60</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">14</td><td><div class="gs-vb-leaderboard__model">MiniMax M2.5</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--minimax">MiniMax</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">1.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:6.7%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.181</td><td class="gs-vb-leaderboard__meta">3/200</td><td class="gs-vb-leaderboard__meta">45.0s</td><td class="gs-vb-leaderboard__meta">$3.25</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">14</td><td><div class="gs-vb-leaderboard__model">MiniMax M2.7</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--minimax">MiniMax</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">1.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:6.7%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.099</td><td class="gs-vb-leaderboard__meta">3/200</td><td class="gs-vb-leaderboard__meta">22.8s</td><td class="gs-vb-leaderboard__meta">$1.74</td></tr>
