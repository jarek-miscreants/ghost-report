            <tr><td class="gs-vb-leaderboard__rank">10</td><td><div class="gs-vb-leaderboard__model">GPT-5 Mini</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--openai">OpenAI</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">5.0%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:22.2%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.275</td><td class="gs-vb-leaderboard__meta">10/200</td><td class="gs-vb-leaderboard__meta">25.4s</td><td class="gs-vb-leaderboard__meta">$3.63</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">11</td><td><div class="gs-vb-leaderboard__model">DeepSeek V3.2</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--deepseek">DeepSeek</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">4.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:20%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.253</td><td class="gs-vb-leaderboard__meta">9/200</td><td class="gs-vb-leaderboard__meta">78.7s</td><td class="gs-vb-leaderboard__meta">$3.25</td></tr>
