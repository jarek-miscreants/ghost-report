  <!-- Footer -->
  <footer class="gs-vb-footer">
    <div class="gs-vb-footer__inner">
      <div class="gs-vb-footer__bar">
        <div class="gs-vb-footer__links">
          <span>VulnBench</span>
          <span class="sep">/</span>
          <span>Ghost Security</span>
          <span class="sep">/</span>
          <span>RSA Conference 2026</span>
        </div>
        <div class="gs-vb-footer__note">
          Built with data from the GitHub Advisory Database and NIST NVD
        </div>
      </div>
    </div>
