            <tr><td class="gs-vb-leaderboard__rank">6</td><td><div class="gs-vb-leaderboard__model">Gemini 3 Flash</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--google">Google</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">7.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:33.3%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.318</td><td class="gs-vb-leaderboard__meta">15/200</td><td class="gs-vb-leaderboard__meta">5.1s</td><td class="gs-vb-leaderboard__meta">$3.13</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">7</td><td><div class="gs-vb-leaderboard__model">GLM-5</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--zhipu">Zhipu AI</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">7.0%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:31.1%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.249</td><td class="gs-vb-leaderboard__meta">14/200</td><td class="gs-vb-leaderboard__meta">91.9s</td><td class="gs-vb-leaderboard__meta">$4.26</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">8</td><td><div class="gs-vb-leaderboard__model">Kimi K2.5</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--moonshot">Moonshot AI</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">6.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:28.9%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.228</td><td class="gs-vb-leaderboard__meta">13/200</td><td class="gs-vb-leaderboard__meta">65.7s</td><td class="gs-vb-leaderboard__meta">$3.47</td></tr>
