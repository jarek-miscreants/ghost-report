---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navigation -->
  <header class="gs-nav">
    <div class="gs-nav__inner">
      <a href="/" class="gs-nav__pill">
        <span style="font-weight:700;font-size:14px;letter-spacing:-0.02em">ghost</span>
      </a>
      <nav class="gs-nav__links">
        <a href="#findings" class="gs-nav__link">[F] Findings</a>
        <a href="#leaderboard" class="gs-nav__link">[L] Leaderboard</a>
        <a href="#methodology" class="gs-nav__link">[M] Methodology</a>
        <a href="#dataset" class="gs-nav__link">[D] Dataset</a>
      </nav>
      <a href="/" class="gs-nav__link gs-nav__login">[H] Home</a>
      <button class="gs-nav__hamburger" id="gs-nav-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="gs-nav__mobile" id="gs-nav-mobile">
      <a href="#findings" class="gs-nav__link">[F] Findings</a>
      <a href="#leaderboard" class="gs-nav__link">[L] Leaderboard</a>
      <a href="#methodology" class="gs-nav__link">[M] Methodology</a>
      <a href="#dataset" class="gs-nav__link">[D] Dataset</a>
      <a href="/" class="gs-nav__link">[H] Home</a>
    </div>
  </header>

  <!-- Hero -->
  <section class="gs-vb-hero">
    <div class="gs-vb-hero__shader" id="gs-vb-hero-shader"></div>
    <div class="gs-vb-hero__inner">
      <div class="gs-vb-hero__content">
        <div class="gs-vb-hero__eyebrow">
          <span>RSA Conference 2026</span>
          <span class="gs-vb-hero__eyebrow-sep">/</span>
          <span>Ghost Security</span>
        </div>
        <h1 class="gs-vb-hero__title">Can LLMs Fix Real-World<br>Security Vulnerabilities?</h1>
        <p class="gs-vb-hero__desc">
          We tested 16 frontier language models on the curated VulnBench-200 evaluation subset
          using best-of-3 runs with description-only file hints. The best model fixes 22.5% of
          instances. The median: only ~5.5%.
        </p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <div class="gs-vb-stats">
    <div class="gs-vb-stats__inner">
      <div class="gs-vb-stats__item"><div class="gs-vb-stats__value">16</div><div class="gs-vb-stats__label">Models Tested</div></div>
      <div class="gs-vb-stats__item"><div class="gs-vb-stats__value">200</div><div class="gs-vb-stats__label">Real CVEs</div></div>
      <div class="gs-vb-stats__item"><div class="gs-vb-stats__value">55</div><div class="gs-vb-stats__label">CWE Types</div></div>
      <div class="gs-vb-stats__item"><div class="gs-vb-stats__value">7</div><div class="gs-vb-stats__label">Ecosystems</div></div>
    </div>
  </div>

  <!-- Findings -->
  <section class="gs-vb-findings" id="findings">
    <div class="gs-vb-findings__inner">
      <div class="gs-section-eyebrow">Key Findings</div>
      <h2 class="gs-section-title">What We Learned</h2>
      <p class="gs-section-desc">
        With description-only file hints and best-of-3 variance reduction, even the best model
        patches fewer than 1 in 4 real vulnerabilities. Performance drops sharply outside the top 5.
      </p>
      <div class="gs-vb-findings__grid">
        <div class="gs-vb-finding"><div class="gs-vb-finding__value">22.5%</div><div class="gs-vb-finding__label">Best Model Pass Rate</div><p class="gs-vb-finding__desc">GPT-5.3 Codex leads the benchmark, successfully patching 45 of 200 real vulnerabilities — 4 percentage points ahead of second place.</p></div>
        <div class="gs-vb-finding"><div class="gs-vb-finding__value">~5.5%</div><div class="gs-vb-finding__label">Median Model Pass Rate</div><p class="gs-vb-finding__desc">The median model fixes roughly 1 in 18 vulnerabilities. Only the top 4 models exceed 15%, and none reach 25%.</p></div>
        <div class="gs-vb-finding"><div class="gs-vb-finding__value">16.0%</div><div class="gs-vb-finding__label">Best Non-OpenAI Model</div><p class="gs-vb-finding__desc">Claude Opus 4.6 is the highest-scoring non-OpenAI model at 16.0%, followed by Claude Sonnet 4.6 at 10.5%.</p></div>
        <div class="gs-vb-finding"><div class="gs-vb-finding__value">0.468</div><div class="gs-vb-finding__label">Highest Mean Judge Score</div><p class="gs-vb-finding__desc">GPT-5.3 Codex achieves the highest mean judge score, indicating its patches are closer to the ground-truth fix.</p></div>
        <div class="gs-vb-finding"><div class="gs-vb-finding__value">3x</div><div class="gs-vb-finding__label">Best-of-3 Variance Reduction</div><p class="gs-vb-finding__desc">Each model is run 3 times per instance, taking the best result. This reduces noise from sampling variance.</p></div>
        <div class="gs-vb-finding"><div class="gs-vb-finding__value">0%</div><div class="gs-vb-finding__label">Complete Failures</div><p class="gs-vb-finding__desc">StepFun Step 3.5 Flash produced no valid patches across all 3 runs, scoring 0% on every instance.</p></div>
      </div>
    </div>
  </section>

  <!-- Leaderboard -->
  <section class="gs-vb-leaderboard" id="leaderboard">
    <div class="gs-vb-leaderboard__inner">
      <div class="gs-vb-leaderboard__header">
        <div class="gs-section-eyebrow">Results</div>
        <h2 class="gs-section-title">VulnBench-200 Leaderboard</h2>
        <p class="gs-section-desc">
          All models evaluated on the same 200 CVE instances using best-of-3 runs with
          description-only file hints. Judge: Claude Opus 4.6.
        </p>
      </div>
      <div class="gs-vb-leaderboard__wrap">
        <table>
          <thead>
            <tr>
              <th style="width:48px">#</th>
              <th>Model</th>
              <th>Pass Rate</th>
              <th>Score</th>
              <th>Passed</th>
              <th>Avg Time</th>
              <th>Cost</th>
            </tr>
          </thead>
          <tbody>
            <tr class="gs-vb-leaderboard__first-row"><td class="gs-vb-leaderboard__rank gs-vb-leaderboard__rank--first">1</td><td><div class="gs-vb-leaderboard__model gs-vb-leaderboard__model--first">GPT-5.3 Codex</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--openai">OpenAI</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">22.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill gs-vb-leaderboard__bar-fill--first" style="width:100%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.468</td><td class="gs-vb-leaderboard__meta">45/200</td><td class="gs-vb-leaderboard__meta">43.4s</td><td class="gs-vb-leaderboard__meta">$8.74</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">2</td><td><div class="gs-vb-leaderboard__model">GPT-5.4</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--openai">OpenAI</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">18.5%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:82.2%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.407</td><td class="gs-vb-leaderboard__meta">37/200</td><td class="gs-vb-leaderboard__meta">7.3s</td><td class="gs-vb-leaderboard__meta">$4.81</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">3</td><td><div class="gs-vb-leaderboard__model">Claude Opus 4.6</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--anthropic">Anthropic</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">16.0%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:71.1%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.404</td><td class="gs-vb-leaderboard__meta">32/200</td><td class="gs-vb-leaderboard__meta">19.6s</td><td class="gs-vb-leaderboard__meta">$10.17</td></tr>
            <tr><td class="gs-vb-leaderboard__rank">4</td><td><div class="gs-vb-leaderboard__model">GPT-5.2</div><div class="gs-vb-leaderboard__org gs-vb-leaderboard__org--openai">OpenAI</div></td><td><div class="gs-vb-leaderboard__bar-wrap"><span class="gs-vb-leaderboard__rate">15.0%</span><div class="gs-vb-leaderboard__bar"><div class="gs-vb-leaderboard__bar-fill" style="width:66.7%"></div></div></div></td><td class="gs-vb-leaderboard__meta">0.322</td><td class="gs-vb-leaderboard__meta">30/200</td><td class="gs-vb-leaderboard__meta">75.2s</td><td class="gs-vb-leaderboard__meta">$11.30</td></tr>
