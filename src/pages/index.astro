          <div class="gs-vb-chart__row"><span class="gs-vb-chart__label" style="width:128px">CWE-400 (DoS)</span><div class="gs-vb-chart__bar"><div class="gs-vb-chart__bar-fill gs-vb-chart__bar-fill--neutral" style="width:65.8%"></div></div><span class="gs-vb-chart__count">25</span></div>
